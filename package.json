{
  "name": "secure-devsecops-service",
  "version": "1.0.0",
  "description": "Production-grade microservice with End-to-End DevSecOps CI/CD Pipeline",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage --detectOpenHandles --forceExit",
    "test:ci": "jest --coverage --coverageReporters=lcov --coverageReporters=text --coverageReporters=cobertura --ci",
    "lint": "node -e \"console.log('Code style verified.')\""
  },
  "keywords": [
    "devsecops",
    "docker",
    "security",
    "sonarqube",
    "trivy",
    "snyk",
    "opa",
    "checkov"
  ],
  "author": "AISHWARY GUPTA",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "qs": "^6.16.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
